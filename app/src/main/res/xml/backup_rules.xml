<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower.
   Progress photos stay out: backups are capped at 25 MB, and going over stops the whole backup,
   diary and weights included. Photos are covered by Export my data instead.
-->
<full-backup-content>
    <exclude domain="file" path="progress_photos/" />
    <exclude domain="file" path="backup_work/" />
</full-backup-content>
